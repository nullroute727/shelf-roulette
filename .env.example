# Shelf Roulette configuration.
# Copy to .env and edit that copy. .env is gitignored; this file is not.
#
#   cp .env.example .env
#   docker compose up -d

# REQUIRED. The numeric Goodreads user id whose shelf gets spun.
# Open your Goodreads profile and look at the URL:
#
#   https://www.goodreads.com/user/show/12345678-yourname
#                                     ^^^^^^^^
#
# The digits before the dash are the id. There is no default: until this is
# set, /api/shelf returns an error saying so.
GOODREADS_USER_ID=

# Which shelf to read. Goodreads uses lowercase, hyphenated shelf names.
GOODREADS_SHELF=to-read

# How long the parsed shelf is cached in memory, in seconds.
# A spin never refetches inside this window. 3600 is one hour.
SHELF_TTL_SECONDS=3600

# Only needed if the Goodreads profile is private.
# Open the shelf page on Goodreads, find the RSS link at the bottom of the page,
# and copy the value of its key= query parameter here. Leave empty for a public
# profile.
GOODREADS_RSS_KEY=

# Host port the web UI is published on. Open http://<host>:8088 by default.
HOST_PORT=8088

# Proxy log verbosity: critical, error, warning, info, debug.
LOG_LEVEL=info

# Which published image tag to run. "latest" tracks the newest release; pin it
# to a version like 1.0.0 if you would rather upgrade deliberately. Ignored when
# you build from source with `docker compose up -d --build`.
SHELF_ROULETTE_TAG=latest
